+void* capture_cvi_impl::raw_frame()
+{
+    return b_frame_held ? (void*)&stFrameInfo : (void*)0;
+}
+
+void* capture_cvi_impl::raw_bgr_frame()
+{
+    return b_frame_held ? (void*)&stFrameInfo_bgr : (void*)0;
+}
+
+int capture_cvi_impl::capture(unsigned char* bgrdata)
+{
+    /* Read, but do not release: the caller owns the frames until it calls
+       release_image_ptr(). */
+    b_frame_held = 1;
+    int ret = read_frame(bgrdata);
+    if (ret != 0)
+    {
+        b_frame_held = 0;
+    }
+    return ret;
+}
+
+void capture_cvi_impl::raw_unmap_all()
+{
+    for (int i = 0; i < raw_map_count; i++)
+    {
+        CVI_SYS_Munmap(raw_maps[i].va, raw_maps[i].len);
+        raw_maps[i].phy = 0;
+        raw_maps[i].va = NULL;
+        raw_maps[i].len = 0;
+    }
+    raw_map_count = 0;
+}
+
+/* Map a plane (or hand back the cached mapping) and re-sync the cache with
+   what the DMA engine just wrote. Returns NULL when the address is unusable,
+   which the caller treats as an empty frame. */
+void* capture_cvi_impl::raw_map_plane(CVI_U64 phy, CVI_U32 len)
+{
+    if (phy == 0 || len == 0) return NULL;
+
+    for (int i = 0; i < raw_map_count; i++)
+    {
+        if (raw_maps[i].phy == phy)
+        {
+            CVI_SYS_IonInvalidateCache(phy, raw_maps[i].va, len);
+            return raw_maps[i].va;
+        }
+    }
+
+    void* p = CVI_SYS_MmapCache(phy, len);
+    if (p == NULL) return NULL;
+
+    CVI_SYS_IonInvalidateCache(phy, p, len);
+
+    if (raw_map_count < kRawMapMax)
+    {
+        raw_maps[raw_map_count].phy = phy;
+        raw_maps[raw_map_count].va = p;
+        raw_maps[raw_map_count].len = len;
+        raw_map_count++;
+    }
+
+    return p;
+}
+
+int capture_cvi_impl::release_image_ptr()
+{
+    if (!b_frame_held)
+    {
+        return -1;
+    }
+
+    b_frame_held = 0;
+
+    if (b_vpss_frame_got)
+    {
+        CVI_VPSS_ReleaseChnFrame(VpssGrp, VpssChn, &stFrameInfo_bgr);
+        b_vpss_frame_got = 0;
+    }
+
+    if (b_vi_frame_got)
+    {
+        CVI_VI_ReleaseChnFrame(ViPipe, ViChn, &stFrameInfo);
+        b_vi_frame_got = 0;
+    }
+
+    return 0;
+}
