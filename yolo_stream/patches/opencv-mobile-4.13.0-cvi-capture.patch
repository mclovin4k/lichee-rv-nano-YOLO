+std::pair<void*, void*> VideoCapture::capture(Mat& image)
+{
+    std::pair<void*, void*> ret((void*)0, (void*)0);
+
+    if (!d->is_opened)
+        return ret;
+
+#if CV_WITH_CVI
+    if (capture_cvi::supported())
+    {
+        image.create(d->height, d->width, CV_8UC3);
+
+        int retVal = d->cap_cvi.capture((unsigned char*)image.data);
+        if (retVal != 0)
+        {
+            return ret;
+        }
+
+        ret.first = d->cap_cvi.raw_frame();
+        ret.second = d->cap_cvi.raw_bgr_frame();
+    }
+#endif
+    return ret;
+}
+
+void VideoCapture::releaseImagePtr()
+{
+#if CV_WITH_CVI
+    if (capture_cvi::supported())
+    {
+        d->cap_cvi.release_image_ptr();
+    }
+#endif
+}
